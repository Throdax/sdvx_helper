<?xml version="1.0" encoding="UTF-8"?>
<!--
  Assembly descriptor for the SDVX Helper Migrator ZIP.

  Produces:  sdvx_helper_java_migrator.zip

  ZIP layout (user unzips this into the root of their Python installation):

    migrate.exe                   – migrator launcher EXE
    runtime/                      – bundled JRE for the migrator
    app/                          – migrator JAR + jpackage launcher config

    sdvx_helper_java_standalone.zip – the full Java dist (extracted by the migrator at runtime)
    migrate_pkl_to_xml.py           – Python migration script (called by the migrator)
-->
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0
                              https://maven.apache.org/xsd/assembly-2.2.0.xsd">

    <id>migrator</id>

    <formats>
        <format>zip</format>
    </formats>

    <!-- No wrapping directory: contents land directly at the ZIP root -->
    <includeBaseDirectory>false</includeBaseDirectory>

    <fileSets>

        <!-- Migrator launcher EXE -->
        <fileSet>
            <directory>target/jpackage/migrate</directory>
            <outputDirectory>.</outputDirectory>
            <includes>
                <include>*.exe</include>
            </includes>
            <fileMode>0755</fileMode>
        </fileSet>

        <!-- Shared JRE bundled by jpackage -->
        <fileSet>
            <directory>target/jpackage/migrate/runtime</directory>
            <outputDirectory>runtime</outputDirectory>
            <fileMode>0755</fileMode>
        </fileSet>

        <!-- Migrator JAR and jpackage launcher config -->
        <fileSet>
            <directory>target/jpackage/migrate/app</directory>
            <outputDirectory>app</outputDirectory>
            <includes>
                <include>*.cfg</include>
                <include>*.jar</include>
            </includes>
        </fileSet>

        <!-- Full Java dist ZIP (produced by sdvx-helper-dist, renamed to standalone) -->
        <fileSet>
            <directory>../sdvx-helper-dist/target</directory>
            <outputDirectory>.</outputDirectory>
            <includes>
                <include>sdvx_helper_java_standalone.zip</include>
            </includes>
        </fileSet>

        <!-- Python pickle-to-XML migration script -->
        <fileSet>
            <directory>src/main/resources</directory>
            <outputDirectory>.</outputDirectory>
            <includes>
                <include>migrate_pkl_to_xml.py</include>
            </includes>
        </fileSet>

    </fileSets>

</assembly>
